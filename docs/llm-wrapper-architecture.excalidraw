    {
      "id": "legend",
      "type": "text",
      "x": 40,
      "y": 795,
      "width": 1420,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1811180650,
      "version": 1,
      "versionNonce": 168393880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762700000000,
      "link": null,
      "locked": false,
      "text": "Endpoint boxes: name \u00b7 LLM_PROVIDER value \u00b7 auth.   ADC = Application Default Credentials (VM service account in prod, `gcloud auth application-default login` locally).\nOne adapter per SDK: the cloud-hosted variant (Azure, Vertex) is the same SDK with a different client, chosen in the factory. Adding a provider = one adapter + one factory case.",
      "originalText": "Endpoint boxes: name \u00b7 LLM_PROVIDER value \u00b7 auth.   ADC = Application Default Credentials (VM service account in prod, `gcloud auth application-default login` locally).\nOne adapter per SDK: the cloud-hosted variant (Azure, Vertex) is the same SDK with a different client, chosen in the factory. Adding a provider = one adapter + one factory case.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
