# Host dir for files + Postgres data (the VM's persistent disk in prod)
DATA_DIR=./data
HTTP_PORT=8080
HTTPS_PORT=8443
# Domain for automatic HTTPS (prod). Leave empty for plain HTTP.
SITE_ADDRESS=

POSTGRES_USER=dess
POSTGRES_PASSWORD=dess
POSTGRES_DB=dess

# LLM provider: openai | azure | gemini | vertex | anthropic | anthropic_vertex
# vertex = Gemini on Vertex AI, anthropic_vertex = Claude on Vertex AI (both use GCP ADC, no key)
LLM_PROVIDER=vertex
# Model ID (Azure: deployment name)
LLM_MODEL=
# openai / azure / gemini / anthropic only
LLM_API_KEY=
# vertex / anthropic_vertex
GCP_PROJECT=
GCP_LOCATION=global
# azure, e.g. https://<resource>.openai.azure.com
AZURE_ENDPOINT=
# Expose /api/llm/* test endpoints (local dev only: they spend LLM credits)
LLM_TEST_ROUTES=false
