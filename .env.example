# Host dir for files + Postgres data (the VM's persistent disk in prod)
DATA_DIR=./data
HTTP_PORT=8080
HTTPS_PORT=8443
# Domain for automatic HTTPS (prod). Leave empty for plain HTTP.
SITE_ADDRESS=

POSTGRES_USER=dess
POSTGRES_PASSWORD=dess
POSTGRES_DB=dess

# LLM provider: openai | azure | gemini | vertex | anthropic | anthropic_vertex
# Team default is gemini (AI Studio key, https://aistudio.google.com/apikey).
# vertex = Gemini on Vertex AI, anthropic_vertex = Claude on Vertex AI (both use GCP ADC, no key)
LLM_PROVIDER=gemini
# Model ID (Azure: deployment name), e.g. gemini-3.6-flash
LLM_MODEL=
# openai / azure / gemini / anthropic only. Put real keys in backend/.env, never in this file.
LLM_API_KEY=
# Per-request timeout; overloaded models otherwise hang
LLM_TIMEOUT_SECONDS=600
# vertex / anthropic_vertex
GCP_PROJECT=
GCP_LOCATION=global
# azure, e.g. https://<resource>.openai.azure.com
AZURE_ENDPOINT=
# Expose /api/llm/* test endpoints (local dev only: they spend LLM credits)
LLM_TEST_ROUTES=false

# Expose /api/profiles and /api/drafts. The API has no auth yet: keep false on public
# deployments, true for local dev.
MINUTES_ROUTES=false
